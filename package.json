{
  "name": "formit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @formit/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && pnpm typecheck",
    "format": "prettier --write .",
    "functions:sync": "node scripts/sync-schema.mjs",
    "functions:serve": "pnpm functions:sync && supabase functions serve --env-file supabase/.env.local",
    "functions:deploy": "pnpm functions:sync && supabase functions deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
